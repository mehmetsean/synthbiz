    "bank_transactions": {
      "description": "Bank statement lines. Each clears one payment or receipt, a few business days after its GL date.",
      "primary_key": [
        "bank_txn_id"
      ],
      "foreign_keys": {},
      "columns": [
        {
          "name": "bank_txn_id",
          "type": "string",
          "description": "Bank line id."
        },
        {
          "name": "bank_date",
          "type": "date",
          "description": "Date the item cleared the bank."
        },
        {
          "name": "amount_cents",
          "type": "integer",
          "description": "Signed amount in cents, negative for money out."
        },
        {
          "name": "ref_type",
          "type": "string",
