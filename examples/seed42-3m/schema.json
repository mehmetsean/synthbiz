    "reconciling_items": {
      "description": "Items in the GL cash balance but not yet on the bank statement at a month end.",
      "primary_key": [
        "month_end",
        "ref_id"
      ],
      "foreign_keys": {},
      "columns": [
        {
          "name": "month_end",
          "type": "date",
          "description": "Month end the item belongs to."
        },
        {
          "name": "item_type",
          "type": "string",
          "description": "OUTSTANDING_PAYMENT or DEPOSIT_IN_TRANSIT."
        },
        {
          "name": "ref_type",
          "type": "string",
          "description": "AP_PAYMENT or AR_RECEIPT."
        },
        {
          "name": "ref_id",
          "type": "string",
          "description": "Payment or receipt id."
        },
        {
          "name": "gl_date",
          "type": "date",
          "description": "Date posted to the GL."
        },
        {
          "name": "bank_date",
          "type": "date",
          "description": "Date it cleared the bank."
        },
        {
          "name": "amount_cents",
          "type": "integer",
          "description": "Signed effect on GL cash in cents."
        }
