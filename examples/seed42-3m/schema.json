    "labels": {
      "description": "One row per injected anomaly. Journal anomalies point to the first line of the entry; every line with the same je_id is part of it. A split_invoice label points to the first invoice of the group and lists the others in details.",
      "primary_key": [
        "table",
        "row_id",
        "anomaly_type"
      ],
      "foreign_keys": {},
      "columns": [
        {
          "name": "table",
          "type": "string",
