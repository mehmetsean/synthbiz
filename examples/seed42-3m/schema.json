{
  "synthetic": true,
  "amounts": "All amounts are integer cents.",
  "tables": {
    "chart_of_accounts": {
      "description": "Ledger accounts. The role column marks control and cash accounts.",
      "primary_key": [
        "account_id"
      ],
      "foreign_keys": {},
      "columns": [
        {
          "name": "account_id",
          "type": "string",
          "description": "Account number."
        },
        {
          "name": "account_name",
          "type": "string",
          "description": "Account name."
        },
        {
          "name": "account_type",
          "type": "string",
          "description": "ASSET, LIABILITY, EQUITY, REVENUE or EXPENSE."
        },
        {
          "name": "normal_balance",
          "type": "string",
          "description": "DEBIT or CREDIT."
        },
        {
          "name": "role",
          "type": "string",
          "description": "CASH, AP_CONTROL, AR_CONTROL or empty."
        }
      ]
    },
    "journal_lines": {
      "description": "One row per journal line. Lines with the same je_id form one entry.",
      "primary_key": [
        "line_id"
      ],
      "foreign_keys": {
        "account_id": "chart_of_accounts.account_id"
      },
      "columns": [
        {
          "name": "line_id",
          "type": "string",
          "description": "Line id."
        },
        {
          "name": "je_id",
          "type": "string",
          "description": "Journal entry id."
        },
        {
          "name": "line_no",
          "type": "integer",
          "description": "Line number within the entry."
        },
        {
          "name": "posting_date",
          "type": "date",
          "description": "Date the entry was posted."
        },
        {
          "name": "period",
          "type": "string",
          "description": "Accounting period, YYYY-MM."
        },
        {
          "name": "account_id",
          "type": "string",
          "description": "Account posted to."
        },
        {
          "name": "debit_cents",
          "type": "integer",
          "description": "Debit amount in cents."
        },
        {
          "name": "credit_cents",
          "type": "integer",
          "description": "Credit amount in cents."
        },
        {
          "name": "memo",
          "type": "string",
          "description": "Short description."
        },
        {
          "name": "source_type",
          "type": "string",
          "description": "OPENING, AP_INVOICE, AP_PAYMENT, AR_INVOICE, AR_RECEIPT or MANUAL."
        },
        {
          "name": "source_id",
          "type": "string",
          "description": "Id of the subledger row that posted here, empty for manual entries."
        },
        {
          "name": "created_by",
          "type": "string",
          "description": "Role id of the poster."
        },
        {
          "name": "approved_by",
          "type": "string",
          "description": "Role id of the approver, empty if none."
        }
      ]
    },
    "vendors": {
      "description": "Vendor master.",
      "primary_key": [
        "vendor_id"
      ],
      "foreign_keys": {},
