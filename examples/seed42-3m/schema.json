        {
          "name": "je_id",
          "type": "string",
          "description": "Journal entry it posted to."
        },
        {
          "name": "created_by",
          "type": "string",
          "description": "Role id that entered it."
        },
        {
          "name": "approved_by",
          "type": "string",
          "description": "Role id that approved it."
        }
      ]
