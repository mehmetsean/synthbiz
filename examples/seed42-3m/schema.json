        },
        {
          "name": "row_id",
          "type": "string",
          "description": "Primary key of the labeled row."
        },
        {
          "name": "anomaly_type",
          "type": "string",
          "description": "Kind of anomaly."
        },
        {
          "name": "details",
          "type": "string",
          "description": "Short plain description."
        }
      ]
